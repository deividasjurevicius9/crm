    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^30.1.3",
    "knip": "^6.44.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
